# Local development defaults. Copy to .env for docker compose if you need overrides.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=popularity_map
POSTGRES_USER=popularity_map
POSTGRES_PASSWORD=popularity_map
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_VIEW_COOLDOWN_URL=redis://localhost:6379/2
CELERY_BROKER_URL=redis://localhost:6379/1

SESSION_COOKIE_AGE_SECONDS=1209600
LOCATION_LIST_CACHE_TTL_SECONDS=60
VIEW_COOLDOWN_SECONDS=3600

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@popularity-map.local
EMAIL_CONFIRMATION_URL=http://localhost:8000/api/v1/auth/email/confirm/
PASSWORD_RESET_URL=http://localhost:8000/api/v1/auth/password/reset/confirm/
API_DOCS_ENABLED=true

# Production placeholders intentionally empty.
